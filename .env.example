# Single-user password gate (required)
APP_PASSWORD=

# Comedy script generation
ANTHROPIC_API_KEY=

# Voice synthesis
ELEVENLABS_API_KEY=

# Video render — long-form AI presenter (default provider)
HEYGEN_API_KEY=

# Optional override; default is "heygen"
VIDEO_PROVIDER=heygen

# Supabase — Postgres + Storage. We don't use Supabase auth in single-user mode.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cron-driven polling endpoint auth
CRON_SECRET=
